{
  "name": "saas-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:contract": "vitest run --root . tests/contract",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:examples",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "spec:sync": "node scripts/spec-sync.mjs",
    "lint:internal": "node scripts/lint-internal.mjs",
    "lint:fc": "vitest run --root . tests/no-fc.test.ts",
    "pack:all": "node scripts/pack-all.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "typecheck:examples": "tsc -p examples/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.10.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "description": "TypeScript SDK monorepo for saas_core (Frappe SaaS backend)",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
